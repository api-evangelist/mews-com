              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"AccessToken\": \"<string>\",\n  \"AccountingItemUpdates\": [\n    {\n      \"AccountingItemId\": \"<uuid>\",\n      \"BillId\": {\n        \"Value\": \"<uuid>\"\n      },\n      \"AccountId\": {\n        \"Value\": \"<uuid>\"\n      }\n    },\n    {\n      \"AccountingItemId\": \"<uuid>\",\n      \"BillId\": {\n        \"Value\": \"<uuid>\"\n      },\n      \"AccountId\": {\n        \"Value\": \"<uuid>\"\n      }\n    }\n  ],\n  \"Client\": \"<string>\",\n  \"ClientToken\": \"<string>\",\n  \"EnterpriseId\": \"<uuid>\"\n}",
